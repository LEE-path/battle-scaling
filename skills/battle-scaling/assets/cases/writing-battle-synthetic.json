  "scene": {
    "description": "灯光明亮的试炼厅，东门距信标底座五米。比赛目标为携信标穿过东门；双方事先同意不追击离场者。",
    "entities": [
      {
        "id": "beacon",
        "name": "信标",
        "description": "一公斤，未固定在底座上。"
      },
      {
        "id": "east_gate",
        "name": "东门",
        "description": "保持敞开；信标离座后有三秒铃声，铃声结束前不能封门。"
      }
    ]
  },
