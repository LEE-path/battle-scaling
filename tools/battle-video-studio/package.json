{
  "name": "battle-video-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local, reusable battle comparison edits driven by music timing templates",
  "scripts": {
    "prestart": "node scripts/bootstrap.mjs",
    "prestudio": "node scripts/bootstrap.mjs",
    "pretypecheck": "node scripts/bootstrap.mjs",
    "start": "node scripts/server.mjs",
    "studio": "remotion studio src/index.ts --port=3211 --no-open",
    "prepare-job": "node scripts/prepare-job.mjs",
    "render": "node scripts/render-job.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
